# ============================================================
# .env.example — Environment Variables Template
# AI Chatbot for University Help Desk | KIET Group of Institutions
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to GitHub or share secrets.
# ============================================================

# ---------------------------
# Flask Environment
# ---------------------------
# Options: development, production, testing
FLASK_ENV=development
FLASK_APP=src/backend/app.py

# ---------------------------
# Security Configuration
# ---------------------------
# Secret key for session cryptographic signing.
# In production, this MUST be set to a strong random key (min 16 chars).
# Example generation: python -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=replace-with-a-secure-random-secret-key-min-16-chars

# Admin API Key for securing all /api/admin/* endpoints.
# Set a strong, confidential key. Sent via HTTP header: X-Admin-Key
ADMIN_API_KEY=replace-with-a-secure-confidential-admin-key

# ---------------------------
# Server Configuration
# ---------------------------
HOST=127.0.0.1
PORT=5000

# ---------------------------
# Database Configuration
# ---------------------------
# Path to SQLite database file.
# Leave blank to use default location: instance/chatbot.db
DATABASE_PATH=
