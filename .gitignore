# ============================================================
#  .gitignore — AI Chatbot for University Help Desk (KIET)
# ============================================================

# ---------------------------
# Python
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# ---------------------------
# Virtual Environments
# ---------------------------
venv/
env/
ENV/
.venv/
.env_local/
Pipfile.lock

# ---------------------------
# Environment & Secrets
# ---------------------------
.env
*.env
secrets.json
credentials.json

# ---------------------------
# Flask / Web
# ---------------------------
instance/
*.db
*.sqlite
*.sqlite3
flask_session/

# ---------------------------
# Distribution / Packaging
# ---------------------------
dist/
build/
*.egg-info/
*.egg
.eggs/
site/

# ---------------------------
# Testing & Coverage
# ---------------------------
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover
nosetests.xml
test-results/

# ---------------------------
# IDEs & Editors
# ---------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# ---------------------------
# OS Generated Files
# ---------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ---------------------------
# Logs
# ---------------------------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------
# Node / Frontend (future)
# ---------------------------
node_modules/
npm-debug.log*

# ---------------------------
# Misc
# ---------------------------
*.bak
*.tmp
*.orig
